# Copy this file to .env and fill in real values for anything beyond local dev.

# --- Django core ---
SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database ---
# Leave DB_HOST empty (or unset) to use a local sqlite3 file (db.sqlite3) -
# zero config, good for trying the project out. Set DB_HOST to switch to
# Postgres.
DB_HOST=
POSTGRES_DB=ticket_form_builder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- CORS / CSRF (comma-separated origins, must match your frontend URL) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend URL (used to build invitation / password-reset links) ---
FRONTEND_URL=http://localhost:3000

# --- Organization access token (see authentication/org_token.py) ---
ORGANIZATION_ACCESS_TOKEN_SECRET_KEY=change-me-organization-access-token-secret
ORGANIZATION_ACCESS_TOKEN_ENCRYPTION_KEY=jtBsdl7-HVKnF61JnesSM0xpqB-vkAXboBbIRawVUhU=

# --- Google OAuth ("Sign in with Google") ---
# Leave blank to disable Google sign-in; email/password login still works.
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# --- Email (defaults to printing emails to the console when DEBUG=True) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
