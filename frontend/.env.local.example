# Copy this file to .env.local

# Base URL of the backend (see ../backend). Defaults to http://localhost:8000
# in code if unset, but set it explicitly to avoid surprises.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Websocket origin, used by the public portal ticket page for realtime chat
# updates (see backend/csm/routing.py and backend/backend/asgi.py). Only
# needed if you're running the backend with Daphne/Uvicorn (ASGI) rather
# than plain `manage.py runserver` - see README "Known simplifications".
NEXT_PUBLIC_WS_URL=ws://localhost:8000
